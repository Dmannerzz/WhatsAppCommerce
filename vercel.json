{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ],
  "daemons": {
    "whatsapp-bridge": {
      "root": "whatsapp-bridge/",
      "entrypoint": "Dockerfile",
      "instances": {
        "fra1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "livenessProbe": {
        "httpGet": {
          "port": 3001,
          "path": "/health"
        },
        "initialDelaySeconds": 10,
        "periodSeconds": 30,
        "timeoutSeconds": 5
      }
    }
  }
}
